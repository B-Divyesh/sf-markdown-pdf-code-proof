{
  "name": "markdown-pdf-code-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "npm run test:copy-audit && npm run test:msrv && cargo test --workspace && npm run test:site && npm run test:license",
    "test:copy-audit": "node scripts/audit-copy.mjs --check",
    "test:msrv": "node scripts/check-msrv.mjs",
    "test:site": "npm run build:site && playwright test",
    "test:install": "node scripts/clean-install.mjs",
    "test:license": "node scripts/license-test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "build": "npm run build:cli && npm run build:site",
    "build:cli": "cargo build --workspace --release",
    "build:site": "vite build && node scripts/finalize-site.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
